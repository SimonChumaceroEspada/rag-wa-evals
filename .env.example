OPENAI_API_KEY=sk-change-me
QDRANT_URL=http://localhost:6333
# Deploy (Qdrant Cloud): URL del cluster + API key. Sin esto usa localhost.
# QDRANT_URL=https://xxx.us-east.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=eyJ...
EMBED_MODEL=text-embedding-3-small
# S2: NVIDIA NIM (https://build.nvidia.com/settings). Verificados 2026-09-25:
# chat=nvidia/nemotron-3.5-lightning-30b-a3b, embeddings=nvidia/nemotron-3-embed-1b.
NVIDIA_API_KEY=nvapi-CHANGE-ME
NIM_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
